QMainWindow {
    background-color: #F6F9F7;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #1F2933;
}

#sidebar {
    background-color: #155C3D;
}

#appTitle {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: 700;
}

#appSubtitle {
    color: #D7E8DE;
    font-size: 11px;
}

#sidebarButton {
    background-color: transparent;
    color: #E7F2EB;
    border: none;
    border-radius: 7px;
    padding: 11px 14px;
    text-align: left;
}

#sidebarButton:hover {
    background-color: #1D6D4A;
    color: #FFFFFF;
}

#sidebarButton:checked {
    background-color: #FFFFFF;
    color: #155C3D;
    font-weight: 700;
}

#pageTitle {
    font-size: 27px;
    font-weight: 700;
    color: #164D36;
}

#pageSubtitle {
    color: #607067;
    font-size: 14px;
}

#dashboardScroll {
    background-color: #FFFFFF;
    border: none;
}

#dashboardScrollViewport {
    background-color: #FFFFFF;
}

#dashboardScrollContent {
    background-color: #FFFFFF;
}

#sectionTitle {
    color: #164D36;
    font-size: 16px;
    font-weight: 700;
}

#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #D7E4DC;
    border-radius: 12px;
}

QFrame#dashboardCard:hover {
    background-color: #FCFEFD;
    border: 1px solid #A8C9B4;
}

#cardTitle {
    color: #5C6D63;
    font-size: 13px;
}

#cardValue {
    color: #155C3D;
    font-size: 25px;
    font-weight: 700;
}

#cardDescription {
    color: #8A9990;
    font-size: 12px;
}

#dashboardSectionEyebrow {
    color: #607067;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-top: 6px;
}

#filterPanel {
    background-color: #F5F8F6;
    border: 1px solid #DCE6DF;
    border-radius: 10px;
}

#filterPanelTitle {
    color: #164D36;
    font-size: 13px;
    font-weight: 700;
}

#filterLabel {
    color: #53645A;
    font-size: 12px;
    font-weight: 600;
}

#filterStatus {
    color: #607067;
    font-size: 12px;
    padding-top: 2px;
}

QLabel#cardValue[comparisonRole="neutralMetric"] {
    color: #101828;
    font-weight: 700;
}

QLabel#cardValue[comparisonRole="deltaMetric"][comparisonState="increase"] {
    color: #B42318;
    font-weight: 700;
}

QLabel#cardValue[comparisonRole="deltaMetric"][comparisonState="decrease"] {
    color: #067647;
    font-weight: 700;
}

QLabel#cardValue[comparisonRole="deltaMetric"][comparisonState="neutral"] {
    color: #667085;
    font-weight: 700;
}

#analysisSummary {
    background-color: #EEF7F1;
    color: #155C3D;
    border: 1px solid #D4E8DA;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 600;
}

QPushButton {
    min-height: 36px;
    padding-left: 16px;
    padding-right: 16px;
    border: 1px solid #C9D8CF;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #244D38;
}

QPushButton:hover {
    background-color: #EEF6F1;
    border-color: #89B39B;
}

QPushButton:pressed {
    background-color: #E2EFE7;
}

QPushButton:disabled {
    color: #98A69E;
    background-color: #F0F3F1;
}

#primaryButton {
    background-color: #197047;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

#primaryButton:hover {
    background-color: #145D3B;
}

#primaryButton:disabled {
    background-color: #B8D2C3;
    color: #FFFFFF;
    border: none;
}

#secondaryButton {
    background-color: #FFFFFF;
    color: #53645A;
    border: 1px solid #CBD8D0;
    font-weight: 600;
}

#secondaryButton:hover {
    background-color: #F4F7F5;
    border-color: #9AB5A4;
    color: #244D38;
}

#secondaryButton:pressed {
    background-color: #E9F0EC;
}

#secondaryButton:disabled {
    background-color: #F5F6F5;
    color: #A0AAA4;
    border-color: #E0E5E2;
}

QLineEdit {
    min-height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #FFFFFF;
    color: #1F2933;
    border: 1px solid #CBD8D0;
    border-radius: 6px;
}

QLineEdit:focus {
    border: 1px solid #238255;
}

QComboBox {
    min-height: 36px;
    padding-left: 10px;
    padding-right: 28px;
    background-color: #FFFFFF;
    color: #1F2933;
    border: 1px solid #CBD8D0;
    border-radius: 6px;
}

QComboBox:hover {
    border: 1px solid #7AAA8D;
    background-color: #F8FBF9;
}

QComboBox:focus {
    border: 1px solid #238255;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #D5E1D9;
    background-color: #EDF6F0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2933;
    border: 1px solid #BFD1C5;
    selection-background-color: #DDEFE3;
    selection-color: #164D36;
    outline: 0;
    padding: 4px;
}

QTableWidget,
QTableView {
    background-color: #FFFFFF;
    color: #1F2933;
    border: 1px solid #DCE6DF;
    border-radius: 6px;
    gridline-color: #E6ECE8;
    alternate-background-color: #F8FAF9;
    selection-background-color: #FDE9CC;
    selection-color: #29342D;
}

QTableView::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #E7F2EB;
    color: #174B35;
    border: none;
    border-right: 1px solid #D6E4DA;
    border-bottom: 1px solid #C9D8CF;
    padding: 9px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #E7F2EB;
    border: none;
}

QScrollBar:vertical {
    background: #D0D5DD;
    width: 12px;
    margin: 0px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #2F7650;
    min-height: 34px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #285F42;
}

QScrollBar::handle:vertical:pressed {
    background: #204D36;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #D0D5DD;
    height: 12px;
    margin: 0px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #2F7650;
    min-width: 34px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #285F42;
}

QScrollBar::handle:horizontal:pressed {
    background: #204D36;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: transparent;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

#tableStatus {
    color: #65756B;
    font-size: 12px;
}

/* COMPACT VERTICAL ROW HEADER */

QHeaderView::section:vertical {
    padding: 1px 2px;
    font-size: 10px;
    font-weight: 600;
}


QPushButton#warningButton {
    background-color: #FFF4E5;
    color: #92400E;
    border: 1px solid #E5A04B;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: 700;
}

QPushButton#warningButton:hover {
    background-color: #FDE9CC;
    border-color: #D98A2B;
}

QPushButton#warningButton:pressed {
    background-color: #F8D9AE;
    border-color: #D98A2B;
}

QPushButton#warningButton:disabled {
    background-color: #F2F4F7;
    color: #98A2B3;
    border-color: #D0D5DD;
}
